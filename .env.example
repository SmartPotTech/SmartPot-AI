# Token que la API envía como Bearer (REST) o en el metadato authorization (gRPC). Mínimo 24 caracteres.
SMARTPOT_AI_TOKEN=<AI_SERVICE_TOKEN>
PORT=8000
RUST_LOG=info

# gRPC hacia la API (HTTP/2): socket UNIX compartido y, si hace falta, TCP interno (0 = apagado).
# Sin ninguno, la API usa REST, que pasa por cualquier proxy (incluso HTTP/1.0). Ambos exigen el mismo token.
# AI_GRPC_SOCKET=/var/run/smartpot/ai.sock
GRPC_TCP_PORT=0

# Aprendizaje: SmartPot-Trainer entrena y la IA reenvía las rutas /v1/learning/* (vacío = estado deshabilitado).
# SMARTPOT_TRAINER_URL=http://trainer-smartpot:8001
# Token para llamar al Trainer (por defecto, SMARTPOT_AI_TOKEN).
# SMARTPOT_TRAINER_TOKEN=
# Carpeta compartida con el Trainer: los modelos aprendidos se leen de DATA_DIR/models (vacío = sin modelos aprendidos).
DATA_DIR=data
# Lecturas del primer entrenamiento, para el mensaje mientras el Trainer no informa las suyas.
LEARNING_MIN_SAMPLES=200
# Zona horaria para derivar localHour cuando el request solo trae measuredAt.
AI_TIMEZONE=America/Bogota

# Clave pública Ed25519 (hex, 32 bytes) del Trainer. Con ella solo se cargan modelos firmados con esa clave;
# sin ella se comprueba el hash BLAKE2b del manifiesto, pero no la firma.
# TRUSTED_MODEL_PUBLIC_KEY_HEX=
