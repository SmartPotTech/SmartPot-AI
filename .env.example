# Token que la API envía como Bearer (mínimo 24 caracteres). Debe coincidir con SMARTPOT_AI_TOKEN de la API.
SMARTPOT_AI_TOKEN=<AI_SERVICE_TOKEN>
# Swagger en /docs; déjalo apagado en producción.
DOCS_ENABLED=false
LOG_LEVEL=INFO
# Semilla de los datos sintéticos de entrenamiento (resultados reproducibles).
MODEL_SEED=42

# Aprendizaje con lecturas reales: carpeta del SQLite y los modelos (vacía = en memoria).
DATA_DIR=data
LEARNING_MIN_SAMPLES=200
LEARNING_RETRAIN_EVERY=300
# Segundos entre revisiones del reentrenamiento en segundo plano (0 lo apaga).
LEARNING_CHECK_SECONDS=300
LEARNING_RETENTION_DAYS=60

# gRPC hacia la API (HTTP/2): socket UNIX compartido y, si hace falta, TCP interno (0 = apagado).
# Sin ninguno, la API usa REST. Ambos exigen el mismo SMARTPOT_AI_TOKEN.
# AI_GRPC_SOCKET=/var/run/smartpot/ai.sock
GRPC_TCP_PORT=0
# Clave pública Ed25519 (hex) de SmartPot-Trainer: si se define, solo se recargan modelos firmados con ella.
# TRUSTED_MODEL_PUBLIC_KEY_HEX=
